      "name": "length(string)",
      "type": "int",
      "description": "长度",
      "example": "length(memory.sms)"
    },
    {
      "name": "squareRoot(num)",
      "type": "float",
      "description": "平方根",
      "example": "squareRoot(self.x + self.y)"
    },
    {
      "name": "min(num1, num2)",
      "type": "float",
      "description": "最小值",
      "example": "damage = min(self.hp, self.energy)"
    },
    {
      "name": "max(num1, num2)",
      "type": "float",
      "description": "最大值",
      "example": "max(5, 10) == 10"
    },
    {
      "name": "createMarker(x, y, [height], [teamId], [dir])",
      "type": "marker",
      "description": "创建标记",
      "example": "fireTurretXAtGround_withTarget: createMarker(self.x + 500, self.y + 500)"
    },
    {
      "name": "eventData(name, type, [default])",
      "type": "any type",
      "description": "事件数据",
      "example": "text: %{eventData(name=\"msg\", type=\"string\")}"
    },
    {
      "name": "sin(angle)",
      "type": "float",
      "description": "正弦",
      "example": "sin(10) = 0.173"
    },
    {
      "name": "cos(angle)",
      "type": "float",
      "description": "余弦",
      "example": "cos(60) = 0.5"
    },
    {
      "name": "rnd(min, max)",
      "type": "float",
      "description": "随机",
      "example": "rnd(666, 888)"
    },
    {
      "name": "lowercase(string)",
      "type": "string",
      "description": "小写",
      "example": "lowercase(\"Spaghetti Macaroni Lasagna\") -> \"spaghetti macaroni lasagna\""
    },
    {
      "name": "uppercase(string)",
      "type": "string",
      "description": "大写",
      "example": "uppercase(\"fish dish wish\") -> \"FISH DISH WISH\""
    },
    {
      "name": "direction(x1, y1, x2, y2)",
      "type": "float",
      "description": "方向",
      "example": "direction(self.x, self.y, attacking.x, attacking.y)"
    },
    {
      "name": "directionBetween(unit1, unit2)",
      "type": "float",
      "description": "之间方向",
      "example": "directionBetween(self, lastDamagedBy)"
    },
    {
      "name": "self.isInMap()",
      "type": "bool",
      "description": "在地图中",
      "example": "autoTrigger: if not self.isInMap()"
    },
    {
      "name": "game.mapWidth()",
      "type": "float",
      "description": "游戏地图宽度",
      "example": "fireTurretXAtGround_withTarget: createMarker(rnd(0, game.mapWidth), rnd(0, game.mapHeight))"
    },
    {
      "name": "game.mapHeight()",
      "type": "float",
      "description": "游戏地图高度",
      "example": "fireTurretXAtGround_withTarget: createMarker(rnd(0, game.mapWidth), rnd(0, game.mapHeight))"
    },
    {
      "name": "self.teamDefeatedTech()",
      "type": "bool",
      "description": "队伍技术失败",
      "example": "autoTrigger: if attacking.teamDefeatedTech()"
    },
    {
      "name": "self.teamWipedOut()",
      "type": "bool",
      "description": "队伍被歼灭",
      "example": "autoTrigger: if self.teamWipedOut()"
    },
    {
      "name": "self.teamVictory()",
      "type": "bool",
      "description": "队伍胜利",
      "example": "autoTrigger: if self.teamVictory()"
    }
  ]
}

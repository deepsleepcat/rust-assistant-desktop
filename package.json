{
  "name": "rust-assistant-desktop",
  "version": "0.2.0",
  "private": true,
  "license": "GPL-3.0",
  "description": "铁锈助手 · 铁锈战争模组开发工作台（电脑版）",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:real-mods": "node scripts/check-real-mods.mjs",
    "pack": "npm run build && electron-builder --win",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@earendil-works/pi-agent-core": "file:vendor/pi/packages/agent",
    "@earendil-works/pi-ai": "file:vendor/pi/packages/ai",
    "@earendil-works/pi-telemetry": "file:vendor/pi/packages/telemetry",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "typebox": "^1.3.12",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.10.0",
    "puppeteer-core": "^25.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.deepsleepcat.rust-assistant-desktop",
    "productName": "铁锈助手",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "public/**",
      "build/icon.ico",
      "vendor/pi/LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "铁锈助手",
      "artifactName": "rust-assistant-desktop-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "rust-assistant-desktop-${version}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "deepsleepcat",
      "repo": "rust-assistant-desktop"
    }
  }
}

import { AbsoluteFill, Img, interpolate, staticFile, useCurrentFrame, Easing } from 'remotion';
import { C, FONT, RAINBOW } from './tokens';

const WORDMARK = '铁锈助手';
const TAGLINE = '从一行代码，到一支模组';

// 各功能代表元素：四方飞入围住字标（功能都有代表，Q8 自检）
const PIECES = [
  { file: 'editor-hero-hires.png', x: 170, y: 250, w: 440, h: 370, from: [-260, -120], rot: -4 },
  { file: 'ai-panel.png', x: 1310, y: 240, w: 430, h: 420, from: [260, -110], rot: 4 },
  { file: 'mod-check-full.png', x: 650, y: 690, w: 620, h: 250, from: [0, 260], rot: 0 },
];

/** mulberry32 确定性伪随机（禁止 Math.random） */
function mulberry32(seed: number) {
  return () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/**
 * S8 发布会收尾（镜头内 0–149f）：各功能代表元素四方飞入合影 → 字标
 * letterpress 压轴 + rule 长出 → crane 落机位 + 舞台光 + 彩虹粒子上飘
 * → sign-off hold 满 1s。参考 outro-group-photo-launch 卡。
 */
export const SceneOutro: React.FC = () => {
  const frame = useCurrentFrame();

  // crane 落机位
  const crane = interpolate(frame, [0, 40], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.3, 0, 0.2, 1) });
  const craneT = `perspective(1400px) rotateX(${4 * (1 - crane)}deg) scale(${1.06 - 0.06 * crane})`;

  // 元素飞入
  const piece = (i: number) => {
    const p = PIECES[i];
    const cue = 4 + i * 3;
    const t = interpolate(frame, [cue, cue + 12], [0, 1], {
      extrapolateLeft: 'clamp', extrapolateRight: 'clamp',
      easing: Easing.bezier(0.34, 1.4, 0.44, 1),
    });
    const air = 1 - t;
    const glow = interpolate(frame, [cue + 12, cue + 18], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
    return { p, t, air, glow };
  };

  // 字标 letterpress（延迟到元素基本落位后）
  const wmDelay = 48;
  const wmOut = interpolate(frame, [wmDelay - 4, wmDelay + 2], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  // rule + 延长线
  const ruleT = interpolate(frame, [wmDelay + 10, wmDelay + 22], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.3, 0, 0.2, 1) });
  // tagline
  const tagT = interpolate(frame, [wmDelay + 22, wmDelay + 34], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  // 舞台光
  const stage = interpolate(frame, [wmDelay + 14, wmDelay + 22, wmDelay + 30], [0, 0.5, 0.25], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });

  // 彩虹粒子（30 颗，index 派生确定性）
  const rand = mulberry32(7);
  const parts = Array.from({ length: 30 }, (_, i) => {
    const px = Math.floor(rand() * 1920);
    const baseY = 1000 + Math.floor(rand() * 300);
    const speed = 0.6 + rand() * 1.2;
    const size = 2 + rand() * 2.5;
    const drift = (rand() - 0.5) * 60;
    const color = RAINBOW[i % 4];
    const delay = rand() * 20;
    const opacity = 0.15 + rand() * 0.2;
    return { px, baseY, speed, size, drift, color, delay, opacity };
  });

  return (
    <AbsoluteFill style={{ backgroundColor: C.surface1, transform: craneT, transformOrigin: 'center center', overflow: 'hidden' }}>
      {/* 背景柔光 */}
      <AbsoluteFill style={{ background: 'radial-gradient(1000px 600px at 50% 42%, rgba(255,255,255,0.9), transparent 70%)' }} />

      {/* 舞台光（字标背后） */}
      <AbsoluteFill
        style={{
          background: `radial-gradient(900px 500px at 50% 48%, rgba(66,133,244,${0.16 * stage}), transparent 70%)`,
          pointerEvents: 'none',
        }}
      />

      {/* 元素合影 */}
      {PIECES.map((p, i) => {
        const { t, air, glow } = piece(i);
        if (frame < 4 + i * 12) return null;
        return (
          <div
            key={p.file}
            style={{
              position: 'absolute', left: p.x, top: p.y, width: p.w, height: p.h,
              transform: `translate(${p.from[0] * air}px, ${p.from[1] * air}px) rotate(${p.rot * air * 2}deg) scale(${1.12 - 0.12 * t})`,
              opacity: t,
              filter: air > 0.02 ? `blur(${air * 8}px)` : 'none',
            }}
          >
            <Img src={staticFile(`textures/live/${p.file}`)} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', display: 'block', borderRadius: 6 }} />
            <div style={{ position: 'absolute', inset: 0, borderRadius: 6, boxShadow: `inset 0 0 0 2px ${C.blue}`, opacity: glow * 0.35, pointerEvents: 'none' }} />
          </div>
        );
      })}

      {/* 字标 + rule + tagline */}
      <AbsoluteFill style={{ justifyContent: 'center', alignItems: 'center', pointerEvents: 'none' }}>
        <div style={{ textAlign: 'center', opacity: wmOut }}>
          <div
            style={{
              fontFamily: FONT.display, fontSize: 110, fontWeight: 700, color: C.text1,
              letterSpacing: '0.02em', lineHeight: 1,
              display: 'flex', justifyContent: 'center',
            }}
          >
            {WORDMARK.split('').map((ch, i) => {
              const delay = wmDelay + i * 3;
              const t = interpolate(frame, [delay, delay + 8], [0, 1], {
                extrapolateLeft: 'clamp', extrapolateRight: 'clamp',
                easing: Easing.bezier(0.2, 0.7, 0.25, 1),
              });
              const glintCenter = delay + 8;
              const glint = interpolate(frame, [glintCenter - 3, glintCenter, glintCenter + 4], [0, 1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
              return (
                <span key={i} style={{ position: 'relative', display: 'inline-block', opacity: t, transform: `scale(${1.5 - 0.5 * t})`, transformOrigin: 'center bottom', filter: `blur(${(1 - t) * 6}px)` }}>
                  {ch}
                  <span style={{ position: 'absolute', left: '50%', bottom: -8, transform: 'translateX(-50%)', width: `${glint * 100}%`, height: 4, background: RAINBOW[i % 4], opacity: glint, borderRadius: 2 }} />
                </span>
              );
            })}
          </div>

          {/* rule + 延长线 */}
          <div style={{ position: 'relative', margin: '30px auto 0', width: 300, height: 5, borderRadius: 3, background: C.blue, transform: `scaleX(${ruleT})` }}>
            <div style={{ position: 'absolute', left: -40, top: 1.5, width: 30, height: 2, background: C.blue, borderRadius: 2, transform: `scaleX(${ruleT})` }} />
            <div style={{ position: 'absolute', right: -40, top: 1.5, width: 30, height: 2, background: C.blue, borderRadius: 2, transform: `scaleX(${ruleT})` }} />
          </div>

          {/* tagline */}
          <div
            style={{
              marginTop: 26, fontFamily: FONT.mono, fontSize: 28, letterSpacing: '0.14em', color: C.text2,
              opacity: tagT, transform: `translateY(${(1 - tagT) * 10}px)`,
            }}
          >
            {TAGLINE}
          </div>
        </div>
      </AbsoluteFill>

      {/* 彩虹粒子上飘 */}
      {frame > 0 &&
        parts.map((p, i) => {
          const y = p.baseY - (frame - p.delay) * p.speed * 3.4;
          if (y < -20) return null;
          const x = p.px + p.drift;
          return (
            <div
              key={i}
              style={{
                position: 'absolute', left: x, top: y, width: p.size, height: p.size,
                background: p.color, borderRadius: '50%', opacity: p.opacity,
                pointerEvents: 'none',
              }}
            />
          );
        })}
    </AbsoluteFill>
  );
};

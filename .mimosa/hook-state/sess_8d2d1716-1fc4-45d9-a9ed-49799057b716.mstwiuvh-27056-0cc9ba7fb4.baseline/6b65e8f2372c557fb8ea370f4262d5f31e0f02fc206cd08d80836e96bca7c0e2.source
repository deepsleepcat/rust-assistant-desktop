import { AbsoluteFill, Img, interpolate, staticFile, useCurrentFrame, Easing } from 'remotion';
import { PageCam, CamKey } from './PageCam';
import { C } from './tokens';

// 文件树行在整页坐标系下的槽位（layout.json）
const ROWS = [
  { file: 'tree-row-1.png', y: 162 },
  { file: 'tree-row-2.png', y: 190 },
  { file: 'tree-row-3.png', y: 218 },
  { file: 'tree-row-4.png', y: 246 },
  { file: 'tree-row-5.png', y: 274 },
  { file: 'tree-row-6.png', y: 302 },
  { file: 'tree-row-7.png', y: 330 },
  { file: 'tree-row-8.png', y: 358 },
];
const RX = 6;
const RW = 267;
const RH = 28;

/**
 * S3 三栏 + 文件树（镜头内 0–140f）：空板上文件树行逐条从空中 rotateX
 * 收平嵌入左侧槽位，嵌入瞬间底边亮一道蓝色缝（row-embed 手法）。
 * 底：home-empty（隐藏内容后的空板）。
 */
export const SceneTree: React.FC = () => {
  const frame = useCurrentFrame();

  const CAM_KEYS: CamKey[] = [
    { frame: 0, cx: 140, cy: 520, zoom: 1.32 },
    { frame: 70, cx: 140, cy: 540, zoom: 1.2 },
    { frame: 138, cx: 140, cy: 550, zoom: 1.16 },
  ];
  const EASE = Easing.bezier(0.4, 0, 0.25, 1);

  const outT = interpolate(frame, [135, 140], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.5, 0, 0.6, 1) });

  return (
    <AbsoluteFill style={{ backgroundColor: '#fafafa', opacity: 1 - outT }}>
      <PageCam src="textures/live/home-empty.png" pageH={1080} keys={CAM_KEYS} ease={EASE}>
        {ROWS.map((r, i) => {
          const cue = 8 + i * 7; // 每 7f 一行
          const fly = interpolate(frame, [cue, cue + 10], [0, 1], {
            extrapolateLeft: 'clamp', extrapolateRight: 'clamp',
            easing: Easing.bezier(0.2, 0.8, 0.3, 1.1),
          });
          const air = 1 - fly;
          const seam = interpolate(frame, [cue + 10, cue + 14, cue + 20], [0, 1, 0], {
            extrapolateLeft: 'clamp', extrapolateRight: 'clamp',
          });
          if (frame < cue) return null;
          return (
            <div key={r.file} style={{ position: 'absolute', left: RX, top: r.y, width: RW, height: RH, transformStyle: 'preserve-3d' }}>
              {/* 行体：从上方 -120px 降下，rotateX 收平，轻过冲 */}
              <div
                style={{
                  position: 'absolute', inset: 0,
                  transform: `perspective(900px) translateY(${-120 * air}px) rotateX(${14 * air}deg) scale(${1.08 - 0.08 * fly})`,
                  transformOrigin: 'center center',
                  opacity: fly,
                }}
              >
                <Img src={staticFile(`textures/live/${r.file}`)} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', display: 'block', borderRadius: 4 }} />
              </div>
              {/* 嵌入瞬间蓝色底缝 */}
              <div
                style={{
                  position: 'absolute', left: 0, right: 0, bottom: -1, height: 2,
                  background: C.blue, opacity: seam, borderRadius: 2,
                  boxShadow: `0 0 6px ${C.blue}`,
                  transform: `scaleX(${seam})`,
                  pointerEvents: 'none',
                }}
              />
            </div>
          );
        })}
      </PageCam>
    </AbsoluteFill>
  );
};

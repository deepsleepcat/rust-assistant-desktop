import { interpolate, useCurrentFrame, Easing } from 'remotion';
import { C, FONT } from './tokens';

/** 底部通栏解说：等宽小字 + 蓝色方块，入出场带轻推。 */
export const Caption: React.FC<{ text: string; duration: number; bottom?: number }> = ({
  text,
  duration,
  bottom = 76,
}) => {
  const frame = useCurrentFrame();
  const inT = interpolate(frame, [0, 8], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const outT = interpolate(frame, [duration - 8, duration], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });

  return (
    <div
      style={{
        position: 'absolute',
        left: 0,
        right: 0,
        bottom,
        display: 'flex',
        justifyContent: 'center',
        alignItems: 'center',
        gap: 14,
        fontFamily: FONT.mono,
        fontSize: 32,
        fontWeight: 600,
        letterSpacing: '0.08em',
        color: C.text1,
        textShadow: '0 1px 0 rgba(255,255,255,0.85)',
        opacity: inT * outT,
        transform: `translateY(${(1 - inT) * 10}px)`,
        pointerEvents: 'none',
      }}
    >
      <span style={{ width: 8, height: 8, background: C.blue, display: 'inline-block', borderRadius: 2 }} />
      <span>{text}</span>
    </div>
  );
};

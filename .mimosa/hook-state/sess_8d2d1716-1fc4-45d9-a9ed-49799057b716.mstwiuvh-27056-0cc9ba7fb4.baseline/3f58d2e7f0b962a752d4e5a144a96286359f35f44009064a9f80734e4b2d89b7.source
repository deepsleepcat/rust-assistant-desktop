import { AbsoluteFill, Img, interpolate, staticFile, useCurrentFrame, Easing } from 'remotion';
import { PageCam, CamKey } from './PageCam';
import { C, FONT } from './tokens';

// 主角：编辑器单位代码卡（rifle.txt）。全页底用 home-editor-full（2x），
// 主角用 editor-hero-hires（4x 元素级截图）叠层，推进时保持锐利。
const EDITOR = { x: 280, y: 44, w: 1210, h: 1012 };
const MCX = EDITOR.x + EDITOR.w / 2; // 885
const MCY = EDITOR.y + EDITOR.h / 2; // 550
const RADIUS = 10;

const POP_EASE = Easing.bezier(0.2, 1.25, 0.3, 1);
const RESEAT_EASE = Easing.bezier(0.4, 0, 0.3, 1.05);

/**
 * S2 单主角立传（镜头内 0–140f）：三栏工作台全页正视 → 聚光游走锁定
 * 编辑器代码卡 → 左侧机位推进 → 卡片弹起悬浮 + 蓝色描边光两圈 +
 * 3D 注记"写一个单位/只要几行" → 贴回原位。参考 spotlight-hero-card。
 */
export const SceneHero: React.FC = () => {
  const frame = useCurrentFrame();

  const CAM_KEYS: CamKey[] = [
    { frame: 0, cx: 960, cy: 540, zoom: 0.78, rotX: 0, rotY: 0, rotZ: 0, persp: 1200 },
    { frame: 30, cx: 960, cy: 540, zoom: 0.78, rotX: 0, rotY: 0, rotZ: 0, persp: 1200 },
    { frame: 46, cx: MCX, cy: MCY, zoom: 1.12, rotX: 2, rotY: 8, rotZ: 0.5, persp: 1400 },
    { frame: 138, cx: MCX, cy: MCY, zoom: 1.12, rotX: 2, rotY: 8, rotZ: 0.5, persp: 1400 },
  ];
  const PUSH_EASE = Easing.bezier(0.35, 0, 0.2, 1);

  // 聚光：游走 4 站（正视屏幕空间 %），推进后锁定屏幕中心
  const spotEase = Easing.bezier(0.4, 0, 0.3, 1);
  const spotX = interpolate(frame, [4, 10, 16, 22, 30, 46], [22, 60, 40, 70, 50, 50], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: spotEase });
  const spotY = interpolate(frame, [4, 10, 16, 22, 30, 46], [28, 42, 62, 50, 40, 50], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: spotEase });
  const spotOn = interpolate(frame, [2, 10], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const poolBase = interpolate(frame, [22, 30, 46], [640, 460, 380], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.4, 0, 0.3, 1) });
  const poolPulse = interpolate(frame, [30, 34, 39], [0, 0.06, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const poolRx = poolBase * (1 + poolPulse);
  const poolRy = poolBase * 0.8 * (1 + poolPulse);
  const vignette = interpolate(frame, [22, 30, 46], [0.12, 0.22, 0.28], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });

  // 主角动作弧：rise → hover(bob) → reseat
  const rise = interpolate(frame, [46, 56], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: POP_EASE });
  const reseat = interpolate(frame, [110, 128], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: RESEAT_EASE });
  const lift = rise * (1 - reseat);
  const bob = Math.sin(((frame - 56) / 40) * Math.PI * 2) * 4 * lift;
  const z = 120 * lift + bob;
  const landed = frame >= 128;
  const press = interpolate(frame, [124, 127, 128], [1, 0.997, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });

  const shadow = `0 ${8 * lift}px ${10 + 12 * lift}px rgba(60,64,67,${0.22 * lift}), 0 ${46 * lift}px ${90 * lift}px rgba(60,64,67,${0.24 * lift})`;

  // 原位补丁：主角起飞后覆盖底部纹理里的编辑器
  const slotVis = Math.min(1, rise * 2) * (1 - reseat);
  const landPulse = interpolate(frame, [124, 128, 132], [0, 1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const slotEdge = Math.min(1, 0.4 * (1 - reseat)) + landPulse * 0.6;

  // 描边光两圈（蓝色，第一圈快亮、第二圈慢弱）
  const beam1Prog = interpolate(frame, [62, 76], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.linear });
  const beam1On = frame >= 61 && frame <= 77;
  const beam2Prog = interpolate(frame, [82, 102], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.4, 0, 0.4, 1) });
  const beam2On = frame >= 81 && frame <= 103;
  const beamTrail = interpolate(frame, [102, 110], [0.35, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const bw = EDITOR.w + 6;
  const bh = EDITOR.h + 6;

  // 3D 注记（左侧）
  const noteShow = frame >= 62 && frame <= 128;
  const noteIn = interpolate(frame, [62, 72], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.2, 0.75, 0.3, 1) });
  const noteOut = interpolate(frame, [118, 128], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const noteVis = noteIn * noteOut;
  const noteZ = 96 + Math.sin(((frame - 62) / 44) * Math.PI * 2) * 3;
  const hl = interpolate(frame, [76, 88], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.3, 0, 0.2, 1) });

  // 整镜淡出 → 字卡
  const outT = interpolate(frame, [135, 140], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.5, 0, 0.6, 1) });

  return (
    <AbsoluteFill style={{ backgroundColor: '#fafafa', opacity: 1 - outT }}>
      <PageCam src="textures/live/home-editor-full.png" pageH={1080} keys={CAM_KEYS} ease={PUSH_EASE}>
        {/* 主角卡：起飞悬浮 → 光束 → 归位 */}
        <div style={{ transformStyle: 'preserve-3d' }}>
          {slotVis > 0.02 ? (
            <div
              style={{
                position: 'absolute', left: EDITOR.x - 2, top: EDITOR.y - 2,
                width: EDITOR.w + 4, height: EDITOR.h + 4, background: '#fafafa',
                borderRadius: RADIUS,
                boxShadow: `inset 0 0 26px rgba(66,133,244,${0.12 * slotEdge})`,
                opacity: slotVis,
              }}
            >
              <div style={{ position: 'absolute', inset: 0, borderRadius: RADIUS, border: `1.5px solid ${C.blue}`, opacity: slotEdge, pointerEvents: 'none' }} />
            </div>
          ) : null}

          <div
            style={{
              position: 'absolute', left: EDITOR.x, top: EDITOR.y,
              width: EDITOR.w, height: EDITOR.h,
              transform: `translateZ(${z}px) scale(${press})`,
              transformOrigin: 'center center',
              transformStyle: 'preserve-3d',
            }}
          >
            <div style={{ position: 'absolute', inset: 0, borderRadius: RADIUS, overflow: 'hidden', boxShadow: landed ? 'none' : shadow }}>
              <Img src={staticFile('textures/live/editor-hero-hires.png')} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', display: 'block' }} />
              <div style={{ position: 'absolute', inset: 0, background: 'linear-gradient(160deg, rgba(255,255,255,0.4), transparent 40%)', opacity: lift, pointerEvents: 'none' }} />
            </div>
            <div style={{ position: 'absolute', inset: 0, borderRadius: RADIUS, boxShadow: `inset 0 0 0 1px rgba(66,133,244,${0.5 * lift})`, pointerEvents: 'none' }} />

            {(beam1On || beam2On) && lift > 0.4 ? (
              <svg width={bw} height={bh} viewBox={`0 0 ${bw} ${bh}`} style={{ position: 'absolute', left: -3, top: -3, overflow: 'visible', pointerEvents: 'none', opacity: beam1On ? 1 : 0.62, filter: `drop-shadow(0 0 6px ${C.blue}) drop-shadow(0 0 18px rgba(66,133,244,0.5))` }}>
                <rect x={2} y={2} width={bw - 4} height={bh - 4} rx={RADIUS} fill="none" stroke={C.blue} strokeWidth={beam1On ? 5 : 3.5} strokeLinecap="round" pathLength={1} strokeDasharray="0.14 1" strokeDashoffset={-(beam1On ? beam1Prog : beam2Prog)} />
                <rect x={2} y={2} width={bw - 4} height={bh - 4} rx={RADIUS} fill="none" stroke="rgba(255,255,255,0.9)" strokeWidth={beam1On ? 2.5 : 1.75} strokeLinecap="round" pathLength={1} strokeDasharray="0.14 1" strokeDashoffset={-(beam1On ? beam1Prog : beam2Prog)} />
              </svg>
            ) : null}

            {beamTrail > 0.01 ? (
              <div style={{ position: 'absolute', inset: -3, borderRadius: RADIUS + 3, border: `1.5px solid ${C.blue}`, opacity: beamTrail, pointerEvents: 'none' }} />
            ) : null}
          </div>
        </div>

        {/* 3D 注记：写在编辑器左侧 */}
        {noteShow ? (
          <div style={{ transformStyle: 'preserve-3d', pointerEvents: 'none' }}>
            <div style={{ position: 'absolute', left: 66, top: 560, width: 190, height: 64, transform: 'translateZ(2px)', background: 'radial-gradient(ellipse at 50% 50%, rgba(60,64,67,0.28), transparent 70%)', filter: 'blur(12px)', opacity: 0.55 * noteVis }} />
            <div style={{ position: 'absolute', left: 56, top: 490, width: 220, transform: `translateZ(${noteZ}px) translateY(${(1 - noteIn) * 26}px)`, opacity: noteVis, filter: `blur(${(1 - noteIn) * 4}px)` }}>
              <div style={{ fontFamily: FONT.display, fontSize: 40, fontWeight: 700, color: C.text1, lineHeight: 1.18, letterSpacing: '0.02em' }}>
                写一个单位，
              </div>
              <div style={{ position: 'relative', display: 'inline-block' }}>
                <div style={{ position: 'absolute', left: -5, top: '12%', bottom: '4%', width: `calc(${hl} * (100% + 10px))`, background: C.blueSoft, borderRadius: 4 }} />
                <div style={{ position: 'relative', fontFamily: FONT.display, fontStyle: 'normal', fontSize: 40, fontWeight: 700, color: C.blueDark, lineHeight: 1.18, letterSpacing: '0.02em' }}>
                  只要几行。
                </div>
              </div>
            </div>
          </div>
        ) : null}
      </PageCam>

      {/* 聚光层 */}
      <AbsoluteFill
        style={{
          background: `radial-gradient(${poolRx}px ${poolRy}px at ${spotX}% ${spotY}%, rgba(66,133,244,0.10), rgba(66,133,244,0.03) 45%, rgba(60,64,67,${vignette * spotOn}) 100%)`,
          pointerEvents: 'none',
          opacity: spotOn,
        }}
      />
    </AbsoluteFill>
  );
};

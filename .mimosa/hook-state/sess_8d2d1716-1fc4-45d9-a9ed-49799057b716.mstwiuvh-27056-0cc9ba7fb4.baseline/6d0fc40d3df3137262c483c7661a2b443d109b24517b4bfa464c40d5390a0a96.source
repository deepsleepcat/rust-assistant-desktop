import { AbsoluteFill, Img, interpolate, staticFile, useCurrentFrame, Easing } from 'remotion';
import { PageCam, CamKey } from './PageCam';
import { C, FONT } from './tokens';

const MENU = { x: 117, y: 158, w: 150, h: 130 };
const DIALOG = { x: 700, y: 324, w: 520, h: 433 };

/**
 * S7 模组工具（镜头内 0–120f）：文件面板下拉"模组工具"菜单 → 新建模组
 * 向导弹窗带过冲弹入，顶部蓝色扫描线扫过完成"装配"，向导完成态静止。
 */
export const SceneModtools: React.FC = () => {
  const frame = useCurrentFrame();

  const CAM_KEYS: CamKey[] = [{ frame: 0, cx: 960, cy: 540, zoom: 1.08 }];
  const EASE = Easing.bezier(0.33, 0, 0.15, 1);
  const dim = interpolate(frame, [10, 20], [0, 0.32], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });

  // 菜单下拉
  const menuT = interpolate(frame, [14, 24], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.2, 0.9, 0.3, 1) });

  // 弹窗弹入（overshoot）
  const dlgT = interpolate(frame, [34, 48], [0, 1], {
    extrapolateLeft: 'clamp', extrapolateRight: 'clamp',
    easing: Easing.bezier(0.2, 1.35, 0.3, 1),
  });
  const dlgY = (1 - dlgT) * 60;

  // 蓝色扫描线：48–80f 从弹窗顶部扫到底部（装配感）
  const scan = interpolate(frame, [52, 80], [0, DIALOG.h], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.linear });
  const scanVis = frame >= 50 && frame <= 84;

  // 完成脉冲 + 打包/检查状态
  const donePulse = interpolate(frame, [88, 92, 100], [0, 0.05, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const packT = interpolate(frame, [84, 90], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const checkT = interpolate(frame, [94, 101], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });

  // 底部 caption 提示（画面内，非通栏）
  const hintT = interpolate(frame, [92, 102], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });

  const outT = interpolate(frame, [115, 120], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.5, 0, 0.6, 1) });

  return (
    <AbsoluteFill style={{ backgroundColor: '#fafafa', opacity: 1 - outT }}>
      <AbsoluteFill style={{ filter: frame < 30 ? 'blur(0px)' : 'none' }}>
        <PageCam src="textures/live/mod-check-full.png" pageH={1080} keys={CAM_KEYS} ease={EASE} />
      </AbsoluteFill>
      <AbsoluteFill style={{ background: `rgba(32,33,36,${dim})`, pointerEvents: 'none' }} />

      {/* 模组工具菜单下拉 */}
      {frame >= 14 && (
        <div
          style={{
            position: 'absolute', left: MENU.x, top: MENU.y - (1 - menuT) * 12, width: MENU.w, height: MENU.h,
            opacity: menuT, pointerEvents: 'none',
          }}
        >
          <Img src={staticFile('textures/live/modtools-menu.png')} style={{ width: '100%', height: '100%', display: 'block', borderRadius: 8, boxShadow: '0 8px 24px rgba(60,64,67,0.18)' }} />
        </div>
      )}

      {/* 新建模组向导弹窗 */}
      {frame >= 34 && (
        <AbsoluteFill style={{ justifyContent: 'center', alignItems: 'center', pointerEvents: 'none' }}>
          <div
            style={{
              position: 'relative',
              width: DIALOG.w,
              transform: `translateY(${dlgY}px) scale(${1 + (1 - dlgT) * 0.06})`,
              boxShadow: `0 12px 40px rgba(60,64,67,${0.18 + donePulse}), 0 0 0 ${1 + donePulse * 6}px ${C.blueSoft}`,
              borderRadius: 12,
            }}
          >
            <Img src={staticFile('textures/live/moddialog-create.png')} style={{ width: '100%', height: '100%', display: 'block', borderRadius: 12 }} />
            {/* 扫描线 */}
            {scanVis && (
              <div
                style={{
                  position: 'absolute', left: 0, right: 0, top: scan - 2, height: 3,
                  background: C.blue, borderRadius: 2,
                  boxShadow: `0 0 12px ${C.blue}`,
                  opacity: 0.9,
                }}
              />
            )}
            {/* 打包与单位检查完成态 */}
            {frame >= 84 && (
              <div
                style={{
                  position: 'absolute', left: -40, right: -40, bottom: -86,
                  display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 8,
                  fontFamily: FONT.mono, fontSize: 20, letterSpacing: '0.1em',
                }}
              >
                <div style={{ color: C.green, opacity: packT }}>
                  ✓ 打包完成 · 我的第一个模组.rwmod
                </div>
                <div style={{ color: C.green, opacity: checkT }}>
                  ✓ 单位检查通过 · 未发现问题
                </div>
              </div>
            )}
          </div>
        </AbsoluteFill>
      )}

      {/* 底部解说条 */}
      {frame >= 92 && (
        <div
          style={{
            position: 'absolute', left: 0, right: 0, bottom: 76,
            display: 'flex', justifyContent: 'center',
            fontFamily: FONT.mono, fontSize: 24, letterSpacing: '0.1em', color: C.text2,
            opacity: hintT,
          }}
        >
          <span style={{ width: 8, height: 8, background: C.blue, display: 'inline-block', borderRadius: 2, marginRight: 12 }} />
          新建模组 · 新建单位 · 打包 · 检查
        </div>
      )}
    </AbsoluteFill>
  );
};

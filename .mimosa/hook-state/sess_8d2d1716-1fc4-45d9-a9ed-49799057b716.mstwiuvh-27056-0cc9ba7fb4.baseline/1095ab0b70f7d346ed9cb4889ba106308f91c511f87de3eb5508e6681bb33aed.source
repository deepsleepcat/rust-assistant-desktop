import { AbsoluteFill, Img, interpolate, staticFile, useCurrentFrame, Easing } from 'remotion';
import { PageCam, CamKey } from './PageCam';
import { C } from './tokens';

// 编辑器代码区（整页坐标系）：编辑器 (280,44)，tab 36 + pathbar 32 → 代码区 y≈112
const CODE = { x: 280, y: 112, w: 1211, h: 944 };
const TAB = { x: 280, y: 44, w: 120, h: 35 };

// 代码 reveal 进度关键帧：分段停顿（先慢后快，段间 8–10f 让观众读代码）
const REVEAL_KEYS: [number, number][] = [
  [20, 0], [30, 0.18], [48, 0.18], [56, 0.4], [74, 0.4], [82, 0.62],
  [100, 0.62], [108, 0.85], [126, 0.85], [134, 1],
];

/**
 * S4 多标签编辑器 + 代码打字（镜头内 0–140f）：编辑器标签弹出 → 代码区
 * 从左到右分段揭示（模拟打字），蓝色块光标骑在揭示前沿。
 * 参考 typing-code-block 的"读的是过程"节奏，但用真实截图纹理（Q1）。
 */
export const SceneTyping: React.FC = () => {
  const frame = useCurrentFrame();

  const CAM_KEYS: CamKey[] = [
    { frame: 0, cx: 940, cy: 420, zoom: 1.5 },
    { frame: 60, cx: 900, cy: 430, zoom: 1.44 },
    { frame: 138, cx: 880, cy: 440, zoom: 1.4 },
  ];
  const EASE = Easing.bezier(0.33, 0, 0.15, 1);

  // reveal 进度
  let t = 0;
  for (let i = 0; i < REVEAL_KEYS.length - 1; i++) {
    const [f0, v0] = REVEAL_KEYS[i];
    const [f1, v1] = REVEAL_KEYS[i + 1];
    if (frame >= f0 && frame <= f1) {
      t = interpolate(frame, [f0, f1], [v0, v1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.3, 0, 0.2, 1) });
      break;
    }
    if (frame > f1) t = v1;
  }
  const revealW = CODE.w * t;
  // 光标：跟随揭示前沿，位于代码区垂直中部
  const caretX = CODE.x + revealW;
  const caretOn = frame >= 20 && frame <= 138;
  const caretPulse = Math.floor((frame - 20) / 12) % 2 === 0;

  // 标签弹出
  const tabIn = interpolate(frame, [6, 18], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.2, 0.75, 0.3, 1) });

  // 状态栏微提示：路径
  const statusIn = interpolate(frame, [4, 14], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });

  const outT = interpolate(frame, [135, 140], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.5, 0, 0.6, 1) });

  return (
    <AbsoluteFill style={{ backgroundColor: '#fafafa', opacity: 1 - outT }}>
      <PageCam src="textures/live/home-editor-full.png" pageH={1080} keys={CAM_KEYS} ease={EASE}>
        {/* 编辑器标签弹出 */}
        <div
          style={{
            position: 'absolute', left: TAB.x, top: TAB.y, width: TAB.w, height: TAB.h,
            opacity: tabIn,
            transform: `translateY(${(1 - tabIn) * -18}px) scale(${1.3 - 0.3 * tabIn})`,
            filter: `blur(${(1 - tabIn) * 5}px)`,
            transformOrigin: 'center center',
          }}
        >
          <Img src={staticFile('textures/live/tab-rifle.png')} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', display: 'block' }} />
        </div>

        {/* 代码揭示遮罩 + 光标 */}
        <div style={{ position: 'absolute', left: CODE.x, top: CODE.y, width: CODE.w, height: CODE.h, pointerEvents: 'none' }}>
          {/* 未揭示部分：白色遮罩 */}
          <div
            style={{
              position: 'absolute', right: 0, top: 0, bottom: 0,
              width: CODE.w - revealW,
              background: 'linear-gradient(to bottom, #ffffff, #fdfdfd)',
              boxShadow: 'inset -1px 0 0 rgba(0,0,0,0.06)',
            }}
          />
          {/* 蓝色块光标（方块，编辑器语感） */}
          {caretOn && caretPulse ? (
            <div
              style={{
                position: 'absolute', left: caretX - 4, top: 320, width: 8, height: 26,
                background: C.blue, borderRadius: 2, opacity: 0.9,
                boxShadow: `0 0 8px ${C.blue}`,
              }}
            />
          ) : null}
        </div>

        {/* 状态栏微提示：路径聚焦高亮 */}
        <div
          style={{
            position: 'absolute', left: 0, bottom: 0, height: 24,
            background: 'rgba(255,255,255,0.0)', opacity: statusIn,
          }}
        />
      </PageCam>
    </AbsoluteFill>
  );
};

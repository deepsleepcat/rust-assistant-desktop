import { AbsoluteFill, Img, interpolate, staticFile, useCurrentFrame, Easing } from 'remotion';
import { C, FONT } from './tokens';

export const ScenePalette: React.FC = () => {
  const frame = useCurrentFrame();
  const dim = interpolate(frame, [8, 20], [0, 0.55], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const inT = interpolate(frame, [12, 28], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.2, 1.25, 0.3, 1) });
  const filterT = interpolate(frame, [62, 76], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  const out = interpolate(frame, [110, 120], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
  return (
    <AbsoluteFill style={{ background: '#202124', opacity: out }}>
      <AbsoluteFill style={{ opacity: 1 - dim * 0.45, filter: `blur(${dim * 5}px)` }}><Img src={staticFile('textures/live/home-editor-full.png')} style={{ width: '100%', height: '100%', objectFit: 'cover' }} /></AbsoluteFill>
      <AbsoluteFill style={{ background: `rgba(32,33,36,${dim})` }} />
      <div style={{ position: 'absolute', left: 490, top: 170, width: 940, transform: `translateY(${(1 - inT) * -60}px) scale(${0.9 + inT * 0.1})`, opacity: inT, borderRadius: 18, overflow: 'hidden', boxShadow: '0 26px 70px rgba(0,0,0,0.4)' }}>
        <Img src={staticFile('textures/live/palette-card.png')} style={{ width: '100%', display: filterT < 0.5 ? 'block' : 'none' }} />
        <Img src={staticFile('textures/live/palette-filtered.png')} style={{ width: '100%', display: filterT >= 0.5 ? 'block' : 'none' }} />
        <div style={{ position: 'absolute', left: 42, top: 20, color: C.blueDark, fontFamily: FONT.mono, fontSize: 30, fontWeight: 700, letterSpacing: '0.08em' }}>Ctrl + K</div>
      </div>
      <div style={{ position: 'absolute', left: 0, right: 0, bottom: 140, textAlign: 'center', color: '#ffffff', fontFamily: FONT.mono, fontSize: 34, fontWeight: 700, opacity: interpolate(frame, [76, 88], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }) }}>打包模组 · 一键执行</div>
    </AbsoluteFill>
  );
};

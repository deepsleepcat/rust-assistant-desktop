import { AbsoluteFill, interpolate, useCurrentFrame, Easing } from 'remotion';
import { C, FONT, RAINBOW } from './tokens';

const WORDMARK = '铁锈助手';
const KICKER = 'RUST ASSISTANT · 铁锈战争模组开发工作台';

/**
 * S1 品牌开场（0–110f）：十字准星描画 → 字标逐字压印（彩虹 glint）→
 * kicker 打字机 → 落定 hold 满 1s → 上浮消散交棒。
 * 参考 brand-ink-open（SceneOpen.tsx 帧 0–83 段），视觉改为白底 + 彩虹。
 */
export const SceneBrand: React.FC<{ duration: number }> = ({ duration }) => {
  const frame = useCurrentFrame();

  // 十字准星：竖线先、横线后，画完淡出
  const vDraw = interpolate(frame, [0, 9], [100, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.3, 0, 0.2, 1) });
  const hDraw = interpolate(frame, [8, 18], [100, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.linear });
  const crossFade = interpolate(frame, [24, 32], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });

  // kicker 打字机
  const perChar = 0.7;
  const kickStart = 24;
  const kickChars = Math.floor(Math.max(0, frame - kickStart) / perChar);
  const kickDone = kickStart + KICKER.length * perChar;
  const cursorOn = (() => {
    if (frame < kickStart) return false;
    if (frame < kickDone) return true;
    if (frame > 96) return false;
    const b = frame - kickDone;
    return Math.floor(b / 2) % 2 === 0;
  })();

  // 退场：100→107 上浮 + 缩小 + 淡出
  const brandOut = interpolate(frame, [100, 107], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.4, 0, 0.5, 1) });
  const brandOpacity = 1 - brandOut;
  const groupY = -brandOut * 40;
  const groupScale = 1 - brandOut * 0.12;

  return (
    <AbsoluteFill style={{ backgroundColor: C.canvas, justifyContent: 'center', alignItems: 'center' }}>
      <div
        style={{
          textAlign: 'center',
          transform: `translateY(${groupY}px) scale(${groupScale})`,
          transformOrigin: 'center center',
          opacity: brandOpacity,
        }}
      >
        {/* 十字准星（彩虹：竖蓝、横红） */}
        <svg
          width={72}
          height={72}
          viewBox="0 0 72 72"
          style={{ display: 'block', margin: '0 auto 40px', opacity: crossFade }}
        >
          <line x1={36} y1={4} x2={36} y2={68} stroke={C.blue} strokeWidth={6} strokeLinecap="round" pathLength={100} strokeDasharray={100} strokeDashoffset={vDraw} />
          <line x1={4} y1={36} x2={68} y2={36} stroke={C.red} strokeWidth={6} strokeLinecap="round" pathLength={100} strokeDasharray={100} strokeDashoffset={hDraw} />
        </svg>

        {/* 字标：逐字压印 + 彩虹 glint 短划 */}
        <div
          style={{
            fontFamily: FONT.display,
            fontSize: 150,
            fontWeight: 700,
            color: C.text1,
            letterSpacing: '0.02em',
            lineHeight: 1,
            whiteSpace: 'pre',
            display: 'inline-flex',
            alignItems: 'flex-end',
          }}
        >
          {WORDMARK.split('').map((ch, i) => {
            const delay = 10 + i * 3;
            const t = interpolate(frame, [delay, delay + 12], [0, 1], {
              extrapolateLeft: 'clamp',
              extrapolateRight: 'clamp',
              easing: Easing.bezier(0.2, 0.7, 0.25, 1),
            });
            const glintCenter = delay + 12;
            const glint = interpolate(frame, [glintCenter - 4, glintCenter, glintCenter + 5], [0, 1, 0], {
              extrapolateLeft: 'clamp',
              extrapolateRight: 'clamp',
            });
            return (
              <span
                key={i}
                style={{
                  position: 'relative',
                  display: 'inline-block',
                  opacity: t,
                  transform: `scale(${1.6 - 0.6 * t})`,
                  transformOrigin: 'center bottom',
                  filter: `blur(${(1 - t) * 6}px)`,
                }}
              >
                {ch}
                <span
                  style={{
                    position: 'absolute',
                    left: '50%',
                    bottom: -8,
                    transform: 'translateX(-50%)',
                    width: `${glint * 100}%`,
                    height: 4,
                    background: RAINBOW[i % 4],
                    opacity: glint,
                    borderRadius: 2,
                  }}
                />
              </span>
            );
          })}
        </div>

        {/* kicker 打字机 + 蓝色块光标 */}
        <div
          style={{
            fontFamily: FONT.mono,
            fontSize: 28,
            letterSpacing: '0.12em',
            color: C.text2,
            marginTop: 36,
            height: 32,
            display: 'flex',
            justifyContent: 'center',
            alignItems: 'center',
          }}
        >
          <span style={{ whiteSpace: 'pre' }}>{KICKER.slice(0, kickChars)}</span>
          <span
            style={{
              display: 'inline-block',
              width: 14,
              height: 26,
              marginLeft: 4,
              background: C.blue,
              opacity: cursorOn ? 0.85 : 0,
            }}
          />
        </div>
      </div>
    </AbsoluteFill>
  );
};

{
  "name": "rust-assistant-promo-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts RustAssistantPromo out/promo-v2.mp4",
    "render:nobgm": "remotion render src/index.ts RustAssistantPromo out/promo-v2-nobgm.mp4 --props=props-nobgm.json",
    "still": "remotion still src/index.ts RustAssistantPromo out/qa/frame.png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.239",
    "@remotion/media": "^4.0.239",
    "remotion": "^4.0.239",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^6.0.3"
  }
}
